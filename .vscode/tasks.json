{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "CMake: Configure Debug",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Test Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--preset",
        "debug"
      ],
      "dependsOn": "CMake: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure ASan",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "asan"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build ASan",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "asan"
      ],
      "dependsOn": "CMake: Configure ASan",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Run ASan",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--preset",
        "asan"
      ],
      "dependsOn": "CMake: Build ASan",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "release"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "release"
      ],
      "dependsOn": "CMake: Configure Release",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run a systems experiment",
      "type": "process",
      "command": "${workspaceFolder}/build/debug/${input:labTarget}",
      "dependsOn": "CMake: Build Debug",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "labTarget",
      "type": "pickString",
      "description": "Choose an experiment",
      "options": [
        "scratch",
        "object_model",
        "unique_ownership",
        "vector_lifetime",
        "cv_handshake",
        "stream_io"
      ],
      "default": "scratch"
    }
  ]
}
