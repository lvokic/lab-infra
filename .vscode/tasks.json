{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Format: C++",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/format.py"],
      "problemMatcher": []
    },
    {
      "label": "Format: Check C++",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/tools/format.py", "--check"],
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "CMake: Configure Debug",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Test Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--preset",
        "debug"
      ],
      "dependsOn": "CMake: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure ASan",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "asan"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build ASan",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "asan"
      ],
      "dependsOn": "CMake: Configure ASan",
      "problemMatcher": "$gcc"
    },
    {
      "label": "CMake: Run ASan",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--preset",
        "asan"
      ],
      "dependsOn": "CMake: Build ASan",
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "release"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Build Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "release"
      ],
      "dependsOn": "CMake: Configure Release",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run a systems experiment",
      "type": "process",
      "command": "${workspaceFolder}/build/debug/${input:labTarget}",
      "dependsOn": "CMake: Build Debug",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "labTarget",
      "type": "pickString",
      "description": "Choose an experiment",
      "options": [
        "scratch",
        "object_model",
        "unique_ownership_test",
        "vector_lifetime",
        "container_observe",
        "mini_hash_map_test",
        "mini_bst_map_test",
        "mini_list_test",
        "mini_heap_test",
        "ring_buffer_test",
        "mini_array_test",
        "mini_deque_test",
        "mini_rb_tree_map_test",
        "cv_handshake",
        "stream_io",
        "vector_iterators",
        "mini_vector",
        "sync_exercises_test",
        "bounded_queue_test",
        "atomic_observe",
        "atomic_publication_test",
        "memory_order_exercises_test",
        "memory_observe",
        "memory_access_test",
        "locality_observe",
        "locality_test",
        "false_sharing_observe",
        "false_sharing_test",
        "framing_test",
        "stream_io_test",
        "event_loop_test",
        "epoll_exercises_test",
        "poll_readiness",
        "memory_benchmark",
        "locality_benchmark",
        "false_sharing_benchmark"
      ],
      "default": "scratch"
    }
  ]
}
